# PostgreSQL
DATABASE_URL=postgres://anime:anime@localhost:5432/animelist

# AniList GraphQL API
ANILIST_API_URL=https://graphql.anilist.co

# Auth (generate: openssl rand -hex 32)
JWT_SECRET=

# Server
PORT=4000
FRONTEND_URL=http://localhost:3000

# Seed account (optional; a random password is used when unset)
SEED_DEMO_EMAIL=demo@example.local
SEED_DEMO_USERNAME=demo
SEED_DEMO_PASSWORD=

# Out-of-band admin bootstrap for a fresh environment (optional; skipped when unset)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
